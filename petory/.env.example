# PostgreSQL/PostGIS connection. Do not prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://petory:petory_dev_password@127.0.0.1:5433/petory
# Set true only when the deployed PostgreSQL endpoint requires TLS with a trusted certificate.
DATABASE_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Public URL of this Next.js application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A comma-separated allowlist of public origins that may invoke Server Actions.
ALLOWED_ORIGINS=http://localhost:3000

# Generate a unique random value for each environment; never commit a real secret.
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
SESSION_LIFETIME_SECONDS=1296000
MAX_MEDIA_BYTES=2097152
MAX_MEDIA_PER_ACCOUNT=50
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_GLOBAL=120
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_GLOBAL=30
RATE_LIMIT_RESET_REQUEST=3
RATE_LIMIT_RESET_REQUEST_GLOBAL=60
RATE_LIMIT_RESET_CONFIRM=10
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_REPORT=10

# Password-reset mail is disabled for local development until a sender is configured.
MAIL_PROVIDER=disabled
# MAIL_FROM=hello@example.com
# RESEND_API_KEY=replace-with-provider-key
