POSTGRES_DB=petory
POSTGRES_USER=petory
POSTGRES_PASSWORD=replace-with-a-long-unique-password
APP_DOMAIN=petory.example.com
# Absolute path on the Linux host; contains origin.pem and origin-key.pem.
PETORY_CERT_DIR=/etc/petory/certs
DATABASE_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
NEXT_PUBLIC_APP_URL=https://petory.example.com
ALLOWED_ORIGINS=https://petory.example.com
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
SESSION_LIFETIME_SECONDS=1296000
MAX_MEDIA_BYTES=2097152
MAX_MEDIA_PER_ACCOUNT=50
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_GLOBAL=120
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_GLOBAL=30
RATE_LIMIT_RESET_REQUEST=3
RATE_LIMIT_RESET_REQUEST_GLOBAL=60
RATE_LIMIT_RESET_CONFIRM=10
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_REPORT=10
MAIL_PROVIDER=resend
MAIL_FROM=hello@petory.example.com
RESEND_API_KEY=replace-with-real-provider-key
