.github
.omx
.codex
.agents
.aws
**/node_modules
**/.next
**/coverage
**/test-results
**/playwright-report
**/.DS_Store
**/._*
**/*.log
**/.env
**/.env.*
!/.env.example
!/.env.production.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/certs
